[alias]
  glog = log --all --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
[branch]
  autosetuprebase = always
[core]
  autocrlf = false
  editor = "$GIT_EDITOR"
  excludesfile = "$HOME/.config/git/ignore"
  pager = "$GIT_PAGER"
[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  ui = auto
[commit]
  gpgsign = true
  template = $HOME/.config/git/message"
[delta]
  features = line-numbers decorations
  navigate = true
[diff]
  colorMoved = dimmed-zebra
  tool = "$GIT_DIFF"
[difftool]
  prompt = true
[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[fetch]
  prune = true
[format]
  signoff = true
[init]
  defaultBranch = develop
[interactive]
  diffFilter = delta --color-only
[merge]
  conflictstyle = diff3
  ff = true
  tool = "$GIT_MERGE"
[mergetool]
  prompt = true
[mergetool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\""
[pull]
  rebase = true
[push]
  default = current
[user]
  email = work@josemrb.com
  name = josemrb
  signingkey = 24D836F0ED1E8908
[url "https://github.com/"]
  insteadOf = git://github.com/
[credential "https://github.com"]
  helper = 
  helper = !/usr/bin/env gh auth git-credential
[credential "https://gist.github.com"]
  helper = 
  helper = !/usr/bin/env gh auth git-credential
[rerere]
  enabled = true
[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
